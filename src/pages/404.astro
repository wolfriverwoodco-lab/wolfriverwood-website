---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <div class="wrap section">
    <div class="stack gap-18">
      <h1>That page isn’t here</h1>
      <p class="lede">It may have moved. The shop and our recent work are a good place to pick back up.</p>
      <div class="hero__ctas"><a class="btn" href="/shop/">Shop the workshop <Icon name="arrow-right" class="icon-arrow" /></a><a class="link-arrow" href="/work/">See our work <Icon name="arrow-right" /></a></div>
    </div>
  </div>
</Base>
