---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import catalog from '../data/catalog.json';
import { money } from '../lib/pricing.js';
import Dim from '../components/Dim.astro';
import Sketch from '../components/Sketch.astro';
import SawLine from '../components/SawLine.astro';
import photos from '../data/photos.json';

const buyables = catalog.products.filter((p) => p.mode === 'buy');
const railPhoto: Record<string, string> = {
  'end-grain-cutting-board': 'endgrain-checker-tall',
  'edge-grain-cutting-board': 'striped-board-counter',
  'holiday-serving-tray': 'pumpkin-tray',
  'coaster-set': 'coaster-octagon-holder',
  'challenge-coin-display': 'challenge-coin-display',
  'monogram-sign': 'monogram-sign',
};
const rail = buyables.filter((p) => p.slug !== 'edge-grain-cutting-board');
const photoCount = Object.keys(photos).length;
// Shop by room: a real photo where the shop has one, otherwise a drawing of the kind of piece.
const roomVisual: Record<string, { photo?: string; sketch?: string }> = {
  dining: { sketch: 'dining' }, kitchen: { photo: 'diamond-boards-kitchen' }, living: { photo: 'built-in-wide' },
  bedroom: { sketch: 'bed' }, bath: { sketch: 'vanity' }, builtins: { photo: 'fold-desk-open' }, gifts: { photo: 'coaster-padauk-set' },
};
const inRoom = (id: string) => catalog.products.filter((p: any) => (p.rooms || [p.category]).includes(id));
const roomNote = (id: string) => { const ps = inRoom(id); const buy = ps.filter((p) => p.mode === 'buy').length; return buy ? `${ps.length} pieces · ${buy} to order online` : 'Free consultation'; };

// Growth rings around the badge: slightly irregular, like real ones. Deterministic, so builds don't change.
const ring = (r: number, k: number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 96; i++) {
    const t = (i / 96) * Math.PI * 2;
    const rr = r + Math.sin(t * 3 + k) * 2.2 + Math.sin(t * 7 + k * 2) * 1.1 + Math.cos(t * 2 + k) * 1.6;
    pts.push(`${(200 + rr * Math.cos(t)).toFixed(1)},${(200 + rr * Math.sin(t)).toFixed(1)}`);
  }
  return `M${pts.join('L')}Z`;
};
const rings = [
  { r: 124, n: 1, a: -2.5, label: 'First boards', when: 'Year to confirm' },
  { r: 152, n: 2, a: -0.95, label: 'Furniture and built-ins', when: 'Year to confirm' },
  { r: 182, n: 3, a: 0.55, label: 'Shop opens online', when: '2026' },
];
const marker = (r: number, a: number) => ({ x: (200 + r * Math.cos(a)).toFixed(1), y: (200 + r * Math.sin(a)).toFixed(1) });
---
<Base current="home">
  <section class="hero" data-plane data-opening>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__place">Wolf River Wood Co. · Collierville, Tennessee</p>
        <h1>Heirloom furniture, built by hand to stay in the family.</h1>
        <p class="lede">Dining tables, kitchen islands, vanities, built-ins and bedroom pieces, designed with you on a free call. Plus cutting boards and gifts you can order today.</p>
        <div class="hero__ctas">
          <a class="btn" href="/custom/#consult">Book a free consultation <Icon name="arrow-right" class="icon-arrow" /></a>
          <a class="link-arrow" href="/shop/#gifts">Shop gifts &amp; kitchen <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="hero__media">
        <Photo slug="built-in-cabinets" eager wet sizes="(max-width: 767px) 100vw, 48vw" alt="Built-in shelving and cabinets around a living room fireplace, built by Wolf River Wood Co." />
      </div>
    </div>
  </section>

  <section class="section section--tight" data-plane aria-labelledby="rail-h">
    <div class="wrap">
      <div class="rail-head">
        <h2 id="rail-h">Shop by room</h2>
        <a class="link-arrow" href="/shop/">Shop all <Icon name="arrow-right" /></a>
      </div>
      <Dim label={`${catalog.categories.length} rooms · built to fit`} />
      <ul class="rail rail--rooms">
        {catalog.categories.map((c) => (
          <li>
            <a href={`/shop/#${c.id}`}>
              {roomVisual[c.id]?.photo
                ? <Photo slug={roomVisual[c.id].photo!} wet brand sizes="(max-width: 639px) 62vw, (max-width: 1023px) 36vw, 15vw" alt="" />
                : <Sketch type={roomVisual[c.id]?.sketch || 'dining'} small />}
              <span><strong>{c.label}</strong><span>{roomNote(c.id)}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SawLine />
  <section class="section section--surface" data-plane data-saw-target aria-labelledby="flow-h">
    <div class="wrap flow">
      <Photo slug="diamond-board-bench" wet sizes="(max-width: 767px) 100vw, 45vw" alt="A long board with a row of dark diamonds, on the workbench before finishing" />
      <div>
        <h2 id="flow-h">Heirloom pieces, designed with you</h2>
        <ol>
          <li><b aria-hidden="true">1</b><div><strong>A free call</strong><p>Tell us about the room, the piece and how your family will use it. It costs nothing and commits you to nothing.</p></div></li>
          <li><b aria-hidden="true">2</b><div><strong>A written quote</strong><p>You get the scope, the woods and the price in writing before anything is built.</p></div></li>
          <li><b aria-hidden="true">3</b><div><strong>Built in Collierville</strong><p>Your piece is cut, joined and finished by hand in the shop, one commission at a time.</p></div></li>
        </ol>
      </div>
    </div>
  </section>
  <script is:inline>
    // Saw cut: before the rest of the page paints, close the gap so the next section sits right under the line.
    (function () {
      var h = document.documentElement, t = document.querySelector('[data-saw-target]');
      if (!t || !h.classList.contains('craft-saw') || !h.classList.contains('plane-ready')) return;
      h.style.setProperty('--saw-h', t.offsetHeight + 'px');
      h.classList.add('saw-pending');
    })();
  </script>

  <section class="section section--wood" data-plane aria-labelledby="banner-h">
    <div class="wrap">
      <div class="commission__copy">
        <h2 id="banner-h">Gifts and kitchen pieces you can order today.</h2>
        <p class="lede">End-grain cutting boards, coasters, holiday trays and signs. Choose the size and pattern, see the price, and order online.</p>
        <div><a class="btn" href="/shop/#gifts">Shop gifts &amp; kitchen <Icon name="arrow-right" class="icon-arrow" /></a></div>
      </div>
      <ul class="strip">
        <li><a href="/shop/end-grain-cutting-board/"><figure><Photo slug="endgrain-checker-tall" wet sizes="(max-width: 767px) 100vw, 45vw" /><figcaption>End-grain cutting boards</figcaption></figure></a></li>
        <li><a href="/shop/holiday-serving-tray/"><figure><Photo slug="pumpkin-tray" wet sizes="(max-width: 767px) 50vw, 28vw" /><figcaption>Holiday serving trays</figcaption></figure></a></li>
        <li><a href="/shop/coaster-set/"><figure><Photo slug="coaster-octagon-holder" wet sizes="(max-width: 767px) 50vw, 28vw" /><figcaption>Coaster sets</figcaption></figure></a></li>
      </ul>
    </div>
  </section>

  <section class="section" data-plane aria-labelledby="work-h">
    <div class="wrap">
      <div class="rail-head">
        <h2 id="work-h">Recent work</h2>
        <a class="link-arrow" href="/work/">See all work <Icon name="arrow-right" /></a>
      </div>
      <Dim label={`5 of ${photoCount} photos`} />
      <div class="mosaic">
        <figure class="m-a"><Photo slug="built-in-wide" wet sizes="(max-width: 767px) 100vw, 40vw" /><figcaption>Living room built-ins</figcaption></figure>
        <figure class="m-b"><Photo slug="dog-gate-installed" wet sizes="(max-width: 767px) 50vw, 33vw" /><figcaption>Barn-door dog gate</figcaption></figure>
        <figure class="m-c"><Photo slug="challenge-coin-display" wet sizes="(max-width: 767px) 50vw, 25vw" /><figcaption>Challenge coin display</figcaption></figure>
        <figure class="m-d"><Photo slug="diamond-band-board" wet sizes="(max-width: 767px) 100vw, 58vw" /><figcaption>Diamond band board</figcaption></figure>
        <figure class="m-e"><Photo slug="fold-desk-open" wet sizes="40vw" /><figcaption>Fold-down desk</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--wood" data-plane data-oiled aria-labelledby="maker-h">
    <div class="mapbg" data-craft="map" aria-hidden="true"><img src="/img/collierville-map.svg" alt="" width="1600" height="1387" loading="lazy" decoding="async" data-parallax /></div>
    <div class="wrap maker">
      <div class="maker__mark">
        <svg class="rings" data-craft="rings" viewBox="0 0 400 400" aria-hidden="true">
          {rings.map((g, i) => <path d={ring(g.r, i * 1.7 + .4)} class:list={['ring', i === rings.length - 1 && 'ring--now']} data-ring={g.n} />)}
          {rings.map((g, i) => <path d={ring(g.r, i * 1.7 + .4)} class="ring-hit" data-ring={g.n} />)}
          {rings.map((g) => { const m = marker(g.r, g.a); return <g class="ring-pin" data-ring={g.n}><circle cx={m.x} cy={m.y} r="14" /><text x={m.x} y={Number(m.y) + 5} text-anchor="middle">{g.n}</text></g>; })}
        </svg>
        <div class="badge" role="img" aria-label="Wolf River Wood Co. badge"></div>
      </div>
      <div class="stack gap-18">
        <p class="geo" data-craft="map">Collierville, Tennessee · 35.04° N, 89.66° W</p>
        <h2 id="maker-h">One shop, one piece at a time</h2>
        <p class="lede">Wolf River Wood Co. is a woodworking shop in Collierville, Tennessee. Boards and gifts are made in small batches. Furniture is built one commission at a time.</p>
        <ol class="rings-legend" data-craft="rings" aria-label="The shop so far, ring by ring">
          {rings.map((g) => <li data-ring={g.n} tabindex="0"><b>{g.n}</b><span>{g.label}</span><em>{g.when}</em></li>)}
        </ol>
        <p class="small rings-note" data-craft="rings">Draft: the real years come from the shop.</p>
        <p><a class="link-arrow" href="/about/">Meet the shop and the shop dogs <Icon name="arrow-right" /></a></p>
        <p><a class="link-arrow" href="https://www.facebook.com/profile.php?id=61592891616080" rel="noopener" target="_blank">See new pieces on Facebook<span class="sr-only"> (opens in a new tab)</span> <Icon name="arrow-right" /></a></p>
      </div>
    </div>
      <p class="map-credit" data-craft="map">Map data &copy; <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap contributors<span class="sr-only"> (opens in a new tab)</span></a></p>
  </section>
</Base>
