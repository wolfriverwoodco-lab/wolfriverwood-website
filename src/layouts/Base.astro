---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import fontDisplay from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
import Icon from '../components/Icon.astro';
import Sketch from '../components/Sketch.astro';
import catalog from '../data/catalog.json';
import photos from '../data/photos.json';
import craft from '../data/craft.json';

interface Props { title?: string; description?: string; current?: string; ogImage?: string; bodyClass?: string }
const {
  title,
  description = 'Custom cutting boards, coasters, holiday trays and made-to-order furniture, built by hand in Collierville, Tennessee.',
  current = '',
  ogImage = '/og-default.jpg',
  bodyClass = '',
} = Astro.props;
const fullTitle = title ? `${title} | Wolf River Wood Co.` : 'Wolf River Wood Co. | Custom Woodwork in Collierville, TN';
// Preview build: staging notice + noindex on. Release build sets PUBLIC_STAGING=false.
const staging = import.meta.env.PUBLIC_STAGING !== 'false';
const canonical = new URL(Astro.url.pathname, Astro.site);
// Craft styling switches: staging starts with every idea on; release keeps only PUBLIC_CRAFT ids.
const craftIds = craft.items.map((i) => i.id);
const craftOn = staging ? craftIds : String(import.meta.env.PUBLIC_CRAFT || '').split(',').map((x) => x.trim()).filter((x) => craftIds.includes(x));
const craftHide = craftIds.map((id) => `html:not(.craft-${id}) [data-craft~="${id}"]{display:none !important}`).join('');
const EMAIL = 'wolfriverwoodco@gmail.com';
const FACEBOOK = 'https://www.facebook.com/profile.php?id=61592891616080';
const thumb = (slug: string) => (photos as any)[slug].thumb;
// Products appear in every room they belong to (p.rooms); the first room is their home category.
const byCat = (id: string) => catalog.products.filter((p: any) => (p.rooms || [p.category]).includes(id));
const navCats = catalog.categories;
const ld = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: 'Wolf River Wood Co.',
  description: 'Custom woodworking: cutting boards, coasters, serving trays, displays and made-to-order furniture.',
  email: EMAIL, sameAs: [FACEBOOK], image: new URL('/brand/logo-badge-1024.png', Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Collierville', addressRegion: 'TN', addressCountry: 'US' },
};
---
<!doctype html>
<html lang="en" class={craftOn.length ? craftOn.map((id) => `craft-${id}`).join(' ') : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {staging && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#f2f1ed" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#17110f" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Wolf River Wood Co." />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Wolf River Wood Co. badge beside an end-grain cutting board" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <style is:inline set:html={craftHide}></style>
  {staging && <script is:inline define:vars={{ craftIds }}>
    // Saved checklist choices apply before first paint, so nothing flickers on or off.
    try {
      const saved = JSON.parse(localStorage.getItem('wrw-craft-v1') || '{}');
      for (const id of craftIds) if (id in saved) document.documentElement.classList.toggle('craft-' + id, !!saved[id]);
    } catch {}
  </script>}
  <script is:inline define:vars={{ introEveryLoad: staging }}>
    // Logo intro. Preview build: every page load. Release build: at most once every 3 hours per browser.
    // Never with reduced motion; ?intro always plays it.
    try {
      var KEY = 'wrw-intro-at', GAP = 3 * 60 * 60 * 1000, now = Date.now(), last = 0;
      try { last = Number(localStorage.getItem(KEY)) || 0; } catch (e) {}
      var play = location.search.indexOf('intro') > -1 || introEveryLoad || now - last > GAP;
      if (play && !window.__wrwNoIntro && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('intro');
        try { localStorage.setItem(KEY, String(now)); } catch (e) {}
      }
    } catch (e) {}
  </script>
  <script is:inline>
    // Motion is opt-in: only with JS and without reduced motion does the seam hide content.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('plane-ready');
  </script>
</head>
<body class={bodyClass}>
  <div class="intro-veil" data-craft="howl" aria-hidden="true"><i class="intro-veil__grain"></i></div>
  <a class="skip" href="#main">Skip to content</a>

  <div class="utility">
    <div class="wrap">
      <a class="utility__mail" href={`mailto:${EMAIL}`} aria-label={`Email ${EMAIL}`}><Icon name="envelope-simple" /><span>{EMAIL}</span></a>
      <nav class="utility__pills" aria-label="Quick links">
        <a class="pill" href="/about/">About us</a>
        <a class="pill" href="/work/">Our work</a>
        <a class="pill pill--hot" href="/custom/">Custom work</a>
      </nav>
    </div>
  </div>

  <header class="header">
    {staging && <div class="staging" role="note"><Icon name="pencil-simple" size="14" /><span>Website in progress — being built by HospCreative</span><button class="staging__btn" type="button" data-drawer-open="craft" aria-haspopup="dialog">Style checklist</button></div>}
    <div class="wrap header__bar">
      <div class="header__left">
        <button class="icon-btn only-mobile" type="button" data-drawer-open="menu" aria-label="Open menu" aria-haspopup="dialog"><Icon name="list" size="26" /></button>
      </div>
      <a class="lockup lockup--header" href="/" aria-label="Wolf River Wood Co., home">
        <span class="lockup__moon" data-craft="howl" aria-hidden="true"></span>
        <span class="lockup__mark" aria-hidden="true"></span>
        <span class="lockup__howl" data-craft="howl" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="lockup__word" aria-hidden="true"></span>
        <span class="lockup__shine" data-craft="howl" aria-hidden="true"></span>
      </a>
      <div class="header__right">
        <button class="icon-btn" type="button" data-drawer-open="cart" aria-haspopup="dialog" aria-label="Open cart, 0 items" data-cart-button>
          <Icon name="shopping-bag-open" size="26" />
          <span class="count" data-cart-count hidden>0</span>
        </button>
      </div>
    </div>
    <nav class="nav" aria-label="Main">
      <ul class="wrap nav__list">
        {navCats.map((c) => (
          <li class="nav__item">
            <button class="nav__link" type="button" aria-expanded="false" aria-controls={`pop-${c.id}`} data-menu-toggle>
              {c.label} <Icon name="caret-down" size="14" />
            </button>
            <div class="menu-pop" id={`pop-${c.id}`} data-menu-pop>
              {byCat(c.id).map((p) => (
                <a href={`/shop/${p.slug}/`}>
                  {p.photos.length ? <img src={thumb(p.photos[0])} alt="" width="56" height="56" loading="lazy" /> : <Sketch type={p.sketch} small />}
                  <span><strong>{p.name}</strong><small>{p.mode === 'consult' ? 'Free consultation' : p.summary}</small></span>
                </a>
              ))}
            </div>
          </li>
        ))}
        <li class="nav__item"><a class="nav__link nav__link--cta" href="/custom/" aria-current={current === 'custom' ? 'page' : undefined}>Custom orders</a></li>
      </ul>
    </nav>
  </header>
  <script is:inline>
    // Logo intro: measure where the header logo lives, so it can start large in the middle of the screen and glide here.
    (function () {
      var h = document.documentElement, l = document.querySelector('.lockup--header');
      if (!l || !h.classList.contains('intro') || !h.classList.contains('craft-howl')) return;
      var r = l.getBoundingClientRect(), small = innerWidth < 768;
      // Frame the whole shot: the moon hangs past the wolf on the left by about a third of the mark's width.
      var mw = parseFloat(getComputedStyle(l).getPropertyValue('--mw')) || 40, over = mw * 0.36;
      var s = Math.min(small ? 2.3 : 3.4, (innerWidth * (small ? 0.76 : 0.6)) / (r.width + over));
      h.style.setProperty('--ix', (innerWidth / 2 - (r.left + r.width / 2) + (over / 2) * s) + 'px');
      h.style.setProperty('--iy', (innerHeight / 2 - (r.top + r.height / 2)) + 'px');
      h.style.setProperty('--is', s);
    })();
  </script>

  <div class="storystick" data-craft="storystick" aria-hidden="true"><i></i></div>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer__grid">
        <div class="footer__brand">
          <a class="lockup" href="/" aria-label="Wolf River Wood Co., home" data-footer-lockup><span class="lockup__mark" aria-hidden="true"></span><span class="lockup__word" aria-hidden="true"></span></a>
          <p>Custom woodwork, built by hand in Collierville, Tennessee.</p>
        </div>
        <div>
          <h2>Shop</h2>
          <ul>{catalog.products.filter((p) => p.mode === 'buy').map((p) => <li><a href={`/shop/${p.slug}/`}>{p.name}</a></li>)}</ul>
        </div>
        <div>
          <h2>Custom</h2>
          <ul>
            {catalog.products.filter((p) => p.mode === 'consult').map((p) => <li><a href={`/shop/${p.slug}/`}>{p.name}</a></li>)}
            <li><a href="/custom/#consult">Book a free consultation</a></li>
          </ul>
        </div>
        <div>
          <h2>Get in touch</h2>
          <ul>
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            <li><a href={FACEBOOK} rel="noopener" target="_blank">Facebook<span class="sr-only"> (opens in a new tab)</span></a></li>
            <li><a href="/work/">Our work</a></li>
            <li><a href="/about/">About us</a></li>
            <li><a href="/care/">Product care</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__fine">
        <span>&copy; 2026 Wolf River Wood Co.</span>
        <span>Collierville, Tennessee</span>
      </div>
    </div>
  </footer>

  <dialog class="drawer drawer--left" id="drawer-menu" aria-labelledby="menu-title" data-drawer="menu">
    <div class="drawer__head">
      <h2 id="menu-title">Menu</h2>
      <button class="icon-btn" type="button" data-drawer-close aria-label="Close menu"><Icon name="x" size="24" /></button>
    </div>
    <div class="drawer__body">
      <ul class="mnav">
        {navCats.map((c, i) => (
          <li style={`--i:${i}`}>
            <details>
              <summary>{c.label} <Icon name="caret-down" size="18" /></summary>
              <ul>
                {byCat(c.id).map((p) => <li><a href={`/shop/${p.slug}/`}>{p.photos.length ? <img src={thumb(p.photos[0])} alt="" width="40" height="40" loading="lazy" /> : <Sketch type={p.sketch} small />}{p.name}</a></li>)}
              </ul>
            </details>
          </li>
        ))}
        <li style="--i:7"><a href="/shop/">Shop all <Icon name="arrow-right" /></a></li>
        <li style="--i:8"><a href="/work/">Our work <Icon name="arrow-right" /></a></li>
        <li style="--i:9"><a href="/about/">About us <Icon name="arrow-right" /></a></li>
        <li style="--i:10"><a href="/care/">Product care <Icon name="arrow-right" /></a></li>
        <li style="--i:11"><a href="/custom/">Custom orders <Icon name="arrow-right" /></a></li>
      </ul>
    </div>
    <div class="drawer__foot">
      <a class="btn btn--block" href="/custom/#consult">Book a free consultation</a>
    </div>
  </dialog>

  <dialog class="drawer" id="drawer-cart" aria-labelledby="cart-title" data-drawer="cart">
    <div class="drawer__head">
      <h2 id="cart-title">Your cart</h2>
      <button class="icon-btn" type="button" data-drawer-close aria-label="Close cart"><Icon name="x" size="24" /></button>
    </div>
    <div class="drawer__body" data-cart-body aria-live="polite"></div>
    <div class="drawer__foot" data-cart-foot hidden>
      <div class="totals"><span>Subtotal</span><span data-cart-subtotal></span></div>
      <p class="note"><Icon name="info" />Demo prices. The final total is confirmed on the server at checkout.</p>
      <a class="btn btn--block" href="/checkout/">Go to checkout <Icon name="arrow-right" class="icon-arrow" /></a>
    </div>
  </dialog>

  {staging && (
    <dialog class="drawer craft-panel" id="drawer-craft" aria-labelledby="craft-title" data-drawer="craft">
      <div class="drawer__head">
        <h2 id="craft-title">Style checklist</h2>
        <button class="icon-btn" type="button" data-drawer-close aria-label="Close style checklist"><Icon name="x" size="24" /></button>
      </div>
      <div class="drawer__body">
        <p class="muted small craft-panel__intro">Tick the ideas to keep. Each one turns on or off across the site as you click, and your choices stay in this browser. Copy your picks when you're done.</p>
        {craft.groups.map((g) => (
          <fieldset class="craft-group">
            <legend>{g.label}<span>{g.blurb}</span></legend>
            {craft.items.filter((i) => i.group === g.id).map((i) => (
              <div class="craft-item">
                <input type="checkbox" id={`craft-${i.id}`} value={i.id} data-craft-toggle checked />
                <label for={`craft-${i.id}`}><b>{i.name}</b><small>{i.what}</small></label>
                <p class="craft-item__where">See it: {i.where.map((w, n) => <>{n > 0 && ' · '}<a href={w.href}>{w.label}</a></>)}</p>
              </div>
            ))}
          </fieldset>
        ))}
      </div>
      <div class="drawer__foot">
        <div class="craft-panel__bulk">
          <button class="text-btn" type="button" data-craft-all="1">Turn all on</button>
          <button class="text-btn" type="button" data-craft-all="0">Turn all off</button>
        </div>
        <button class="btn btn--block" type="button" data-craft-copy>Copy my picks</button>
        <p class="small muted" data-craft-status role="status"></p>
      </div>
    </dialog>
  )}

  <script>
    import '../scripts/site.js';
  </script>
  {staging && <script>
    import '../scripts/craft-panel.js';
  </script>}
</body>
</html>
